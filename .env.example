# Datascene VAA1 local development environment
# Copy this file to .env and fill in local values. Do not commit .env.

APP_ENV=development
VAA1_BACKEND_HOST=127.0.0.1
VAA1_BACKEND_PORT=8000
VAA1_FRONTEND_HOST=127.0.0.1
VAA1_FRONTEND_PORT=3001

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CVAT_BASE_URL=http://localhost:8080
DOCKER_API_URL=http://host.docker.internal:8000
CVAT_BRIDGE_URL=http://localhost:3001

# Optional local paths
FFMPEG_PATH=
FFPROBE_PATH=
YOLO_MODEL_PATH=
MEDIA_INPUT_DIR=
MEDIA_OUTPUT_DIR=

# Optional API keys and tokens
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=
