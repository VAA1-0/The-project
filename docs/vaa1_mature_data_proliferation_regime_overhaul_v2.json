        "type": "string",
        "format": "date-time"
      }
    }
  },
  "proliferation_policy": {
    "thresholds": {
      "confirmed_mature_requires": [
        "manual_confirmation",
        "manual_correction"
      ],
      "governed_mature_hypothesis_min_score": 0.72,
      "cross_modal_hypothesis_min_modalities": 2,
      "single_modality_candidate_max_authority": "review_candidate",
      "auto_confirm_forbidden_without_manual_authority": true,
      "legacy_auto_proliferation_0_95_policy": {
        "status": "too_conservative_as_only_route",
        "new_role": "may create strong governed hypothesis, not required as sole propagation path"
      }
    },
    "projection_rules": [
      {
        "rule_id": "PR001",
        "if": "authority_class == confirmed_mature",
        "then": "project_everywhere_allowed_by_object_family"
      },
      {
        "rule_id": "PR002",
        "if": "authority_class == governed_mature_hypothesis",
        "then": "project_with_hypothesis_badge_and_review_affordance"
      },
      {
        "rule_id": "PR003",
        "if": "authority_class == review_candidate",
        "then": "candidate_tray_only_no_mature_panel_override"
      },
      {
        "rule_id": "PR004",
        "if": "authority_class == raw_substrate",
        "then": "raw_layer_and_traceback_only"
      },
      {
        "rule_id": "PR005",
        "if": "decision_state in ['rejected', 'canceled']",
        "then": "inactive_traceback_history_only"
      }
    ]
  },
  "quality_agent_checks": [
    "matcher_only_on_demand",
    "candidate_without_promotion_decision",
    "confirmed_decision_without_projection",
    "artifact_exists_but_not_hydrated",
    "scene_confirmation_not_swept_forward",
    "meaning_network_edge_count_zero_despite_continuity",
    "continuity_anchor_count_zero_despite_reappearance",
    "manual_correction_not_projected",
    "raw_detection_overrides_mature_label",
    "source_sample_missing_for_high_value_confirmation",
    "sample_cloud_not_polled",
    "traceback_missing",
    "export_missing_mature_projection",
    "report_missing_candidate_history"
  ],
  "acceptance_tests": [
    {
      "test_id": "AT001_LIVE_BUS_RUNS_AFTER_ANALYSIS_COMPLETION",
      "given": "Analysis completes with manual/source evidence and later-scene raw detections.",
      "expect": "Live proliferation bus runs without explicit /proliferation/match request and writes sweep audit."
    },
    {
      "test_id": "AT002_MATCHER_OUTPUT_NOT_PROMOTED_WITHOUT_DECISION",
      "given": "Matcher writes candidate artifact.",
      "expect": "No mature projection occurs unless proliferation_decisions contains explicit decision record."
    },
    {
      "test_id": "AT003_GOVERNED_HYPOTHESIS_PROJECTS_WITH_BADGE",
      "given": "Cross-modal candidate score exceeds governed hypothesis threshold but lacks manual confirmation.",
      "expect": "Candidate projects as hypothesis with traceback and review badge, not as confirmed truth."
    },
    {
      "test_id": "AT004_SCENE_1_CONFIRMATION_SWEEPS_TO_SCENE_2",
      "given": "Narrative Agent confirmed in scene 1 and matching visual/audio/sample evidence appears in scene 2.",
      "expect": "Scene continuity anchor is created and scene 2 receives governed mature hypothesis."
    },
    {
      "test_id": "AT005_SAVED_ARTIFACT_HYDRATION_COMPLETE",
      "given": "Tracked object file exists on disk.",
      "expect": "Canonical status hydrates tracked object before matcher runs; missing hydration fails audit."
    },
    {
      "test_id": "AT006_MEANING_NETWORK_CONTINUITY_NONZERO",
      "given": "Same agent/object appears across consecutive scenes.",
      "expect": "Meaning Network edge_count and continuity_anchor_count are greater than zero."
    },
    {
      "test_id": "AT007_SAMPLE_CLOUD_AS_MEMORY_SUBSTRATE",
      "given": "High-value manual confirmation creates source crop/audio window.",
      "expect": "Sample cloud memory is created, attached to promotion decision, and polled in later sweeps."
    },
    {
      "test_id": "AT008_PROJECT_REOPEN_PRESERVES_AUTHORITY",
      "given": "Project is saved and reopened.",
      "expect": "Manual corrections, promotion decisions, continuity anchors, Meaning Network edges, traceback refs, and candidate ledgers reload deterministically."
    }
  ],
  "recommended_delivery_slices": [
    {
      "slice_id": "P0_HYDRATION_FIRST",
      "name": "Saved-analysis hydration closure"
    },
    {
      "slice_id": "P1_LIVE_BUS_MINIMUM",
      "name": "Live bus minimum viable sweep"
    },
    {
      "slice_id": "P2_PROMOTION_LEDGER",
      "name": "Candidate-to-promotion decision ledger"
    },
    {
      "slice_id": "P3_SCENE_CONTINUITY",
      "name": "Scene-to-scene continuity sweep"
    },
    {
      "slice_id": "P4_MEANING_NETWORK_CONTINUITY",
      "name": "Meaning Network continuity edges"
    },
    {
      "slice_id": "P5_SAMPLE_CLOUD_MEMORY",
      "name": "Audiovisual memory clouds"
    }
  ],
