                "emotional_stupidity",
                "callousness"
              ]
            }
          },
          "justice": {
            "teamwork_citizenship": {
              "positive": [
                "cooperation",
                "solidarity",
                "loyalty",
                "shared_responsibility"
              ],
              "antithesis": [
                "betrayal",
                "fragmentation",
                "self_interest",
                "tribal_sabotage"
