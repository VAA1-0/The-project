                "intimacy"
              ],
              "antithesis": [
                "alienation",
                "detachment",
                "abandonment",
                "emotional_coldness"
              ]
            },
            "kindness": {
              "positive": [
                "kindness",
                "compassion",
                "generosity",
                "mercy",
                "helpfulness"
              ],
              "antithesis": [
                "cruelty",
                "sadism",
