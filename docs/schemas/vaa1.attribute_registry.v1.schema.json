{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vaa1.attribute_registry.v1.schema.json",
  "title": "VAA1 Empirical Attribute Registry",
  "type": "object",
  "required": ["schema_version", "status", "generated_at", "attributes"],
  "properties": {
    "schema_version": { "type": "string" },
    "status": { "type": "string" },
    "generated_at": { "type": "string" },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "attribute_id", "subject_type", "value_type", "family", "scope",
          "provenance_class", "architectural_layer", "iteration_model",
          "maturity_behavior", "authority_behavior", "dependencies",
          "invalidation_behavior", "projection_eligible", "implementation_status"
        ],
        "properties": {
          "attribute_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
          "subject_type": { "type": "string", "minLength": 1 },
          "value_type": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "object",
            "required": ["temporal", "spatial"],
            "properties": {
              "temporal": { "type": "boolean" },
              "spatial": { "type": "boolean" }
            }
          },
          "provenance_class": { "type": "string", "minLength": 1 },
          "architectural_layer": { "type": "string", "minLength": 1 },
          "iteration_model": { "type": "string", "minLength": 1 },
          "maturity_behavior": { "type": "string", "minLength": 1 },
          "authority_behavior": { "type": "string", "minLength": 1 },
          "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "invalidation_behavior": { "type": "string", "minLength": 1 },
          "projection_eligible": { "type": "boolean" },
          "implementation_status": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
