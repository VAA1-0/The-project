{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datascene.example/schemas/goffmanian_situated_conduct.schema.json",
  "title": "Comparative Sociology of Situated Conduct",
  "description": "A candidate interpretive lens for analysing how participants make themselves intelligible, sustain or contest definitions of situations, negotiate access, protect face, manage disruption and repair, and organize the perceptual field of interaction.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "reading_id", "framework", "governance", "source_anchors", "participants", "situation_definition", "interaction_events", "interpretive_summary"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "reading_id": {"$ref": "#/$defs/nonEmptyId"},
    "framework": {
      "type": "object", "additionalProperties": false,
      "required": ["framework_id", "display_name", "principal_attribution", "reading_type", "concept_provenance"],
      "properties": {
        "framework_id": {"const": "goffmanian_situated_conduct"},
        "display_name": {"const": "Comparative Sociology of Situated Conduct"},
        "principal_attribution": {"const": "Erving Goffman"},
        "reading_type": {"const": "interpretive_lens"},
        "concept_provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conceptProvenance"}, "uniqueItems": true}
      }
    },
    "governance": {"$ref": "#/$defs/governance"},
    "source_anchors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceAnchor"}},
    "participants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/participant"}},
    "situation_definition": {"$ref": "#/$defs/situationDefinition"},
    "performances": {"type": "array", "items": {"$ref": "#/$defs/performance"}},
    "participation_frameworks": {"type": "array", "items": {"$ref": "#/$defs/participationFramework"}},
    "interaction_events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interactionEvent"}},
    "regions_and_territories": {"type": "array", "items": {"$ref": "#/$defs/regionTerritory"}},
    "frames_and_transformations": {"type": "array", "items": {"$ref": "#/$defs/frameTransformation"}},
    "identity_information": {"type": "array", "items": {"$ref": "#/$defs/identityInformation"}},
    "interpretive_summary": {"$ref": "#/$defs/interpretiveClaim"},
    "alternatives": {"type": "array", "items": {"$ref": "#/$defs/alternative"}},
    "projection_bindings": {"$ref": "#/$defs/projectionBindings"}
  },
  "$defs": {
    "nonEmptyId": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "conceptProvenance": {"type": "object", "additionalProperties": false, "required": ["concept", "attribution", "relation_to_goffman", "source_reference"], "properties": {"concept": {"type": "string", "minLength": 1}, "attribution": {"type": "string", "minLength": 1}, "relation_to_goffman": {"enum": ["goffman_original_or_principal_synthesis", "documented_influence", "genealogical_antecedent", "parallel_postwar_development", "later_extension"]}, "source_reference": {"type": "string", "minLength": 1}, "goffmanian_reformulation": {"type": "string"}, "datascene_operationalization": {"type": "string"}}},
    "governance": {"type": "object", "additionalProperties": false, "required": ["record_status", "authority", "ledger_event_id", "created_at", "created_by", "dependency_ids", "input_snapshot_hash"], "properties": {"record_status": {"enum": ["candidate", "provisionally_accepted", "confirmed", "corrected", "rejected", "conflicted", "superseded", "invalidated", "stale", "unresolved"]}, "authority": {"enum": ["automated_candidate", "imported_candidate", "analyst_proposal", "analyst_confirmed", "analyst_corrected"]}, "ledger_event_id": {"$ref": "#/$defs/nonEmptyId"}, "supersedes_event_id": {"$ref": "#/$defs/nonEmptyId"}, "created_at": {"type": "string", "format": "date-time"}, "created_by": {"type": "string", "minLength": 1}, "provider": {"type": "string"}, "model_or_rule_version": {"type": "string"}, "parameters": {"type": "object"}, "dependency_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "input_snapshot_hash": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"}, "invalidation_reason": {"type": "string"}}},
    "sourceAnchor": {"type": "object", "additionalProperties": false, "required": ["source_id", "anchor_type", "clock_unit", "time_start", "time_end", "clock_authority", "precision_seconds"], "properties": {"source_id": {"$ref": "#/$defs/nonEmptyId"}, "anchor_type": {"enum": ["time_interval", "transcript_span", "frame", "roi", "document_span", "image_region", "web_region", "metadata_record"]}, "clock_unit": {"const": "source_relative_seconds"}, "time_start": {"type": "number", "minimum": 0}, "time_end": {"type": "number", "minimum": 0}, "clock_authority": {"type": "string", "minLength": 1}, "precision_seconds": {"type": "number", "minimum": 0}, "spatial_region": {"$ref": "#/$defs/spatialRegion"}, "text_quote": {"type": "string", "maxLength": 500}, "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}},
    "spatialRegion": {"type": "object", "additionalProperties": false, "required": ["coordinate_system", "x", "y", "width", "height"], "properties": {"coordinate_system": {"enum": ["normalized_0_1", "pixels"]}, "x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "participant": {"type": "object", "additionalProperties": false, "required": ["participant_id", "designation", "presence_status", "evidence_anchor_ids"], "properties": {"participant_id": {"$ref": "#/$defs/nonEmptyId"}, "narrative_agent_id": {"$ref": "#/$defs/nonEmptyId"}, "designation": {"type": "string", "minLength": 1}, "presence_status": {"enum": ["copresent", "remotely_present", "represented", "invoked", "absent_but_relevant", "unknown"]}, "ratification_status": {"enum": ["ratified", "unratified", "bystander", "overhearer", "eavesdropper", "not_assessed"]}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}},
    "situationDefinition": {"type": "object", "additionalProperties": false, "required": ["occasion_type", "working_definition", "consensus_state", "evidence_anchor_ids"], "properties": {"occasion_type": {"type": "string", "minLength": 1}, "working_definition": {"type": "string", "minLength": 1}, "consensus_state": {"enum": ["not_assessed", "emerging", "working_consensus", "contested", "disrupted", "repaired", "collapsed"]}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}},
    "performance": {"type": "object", "additionalProperties": false, "required": ["performance_id", "performer_ids", "audience_ids", "routine", "impression_strategy", "evidence_anchor_ids"], "properties": {"performance_id": {"$ref": "#/$defs/nonEmptyId"}, "performer_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "audience_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "team_id": {"$ref": "#/$defs/nonEmptyId"}, "routine": {"type": "string", "minLength": 1}, "impression_strategy": {"enum": ["expression_given", "expression_given_off", "idealization", "mystification", "misrepresentation_candidate", "concealment", "disclosure", "protective_practice", "defensive_practice", "mixed", "not_assessed"]}, "setting_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "personal_front_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}},
    "participationFramework": {"type": "object", "additionalProperties": false, "required": ["framework_event_id", "participant_id", "participation_status", "footing", "evidence_anchor_ids"], "properties": {"framework_event_id": {"$ref": "#/$defs/nonEmptyId"}, "participant_id": {"$ref": "#/$defs/nonEmptyId"}, "participation_status": {"enum": ["speaker", "addressed_recipient", "ratified_listener", "bystander", "overhearer", "eavesdropper", "represented_party", "unknown"]}, "footing": {"enum": ["stable", "shifted", "ambiguous", "contested", "not_assessed"]}, "production_role": {"enum": ["animator", "author", "principal", "combined", "not_assessed"]}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}},
    "interactionEvent": {"type": "object", "additionalProperties": false, "required": ["event_id", "event_type", "participant_ids", "evidence_anchor_ids", "epistemic_status"], "properties": {"event_id": {"$ref": "#/$defs/nonEmptyId"}, "event_type": {"enum": ["face_claim", "face_threat", "deference", "demeanor", "avoidance", "challenge", "embarrassment", "incident", "account", "apology", "corrective_process", "repair", "disruption", "involvement_shift", "access_negotiation", "information_control", "other"]}, "participant_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "epistemic_status": {"enum": ["observed_relation", "derived_relation", "candidate_interpretation", "confirmed_interpretation"]}, "rationale": {"type": "string", "minLength": 1}}},
    "regionTerritory": {"type": "object", "additionalProperties": false, "required": ["region_id", "region_type", "participant_ids", "evidence_anchor_ids"], "properties": {"region_id": {"$ref": "#/$defs/nonEmptyId"}, "region_type": {"enum": ["front_region", "back_region", "outside", "personal_space", "use_space", "information_preserve", "conversational_preserve", "possessional_territory", "other"]}, "participant_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "access_state": {"enum": ["open", "restricted", "negotiated", "violated", "unknown"]}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}},
    "frameTransformation": {"type": "object", "additionalProperties": false, "required": ["frame_event_id", "primary_framework", "transformation", "frame_state", "evidence_anchor_ids"], "properties": {"frame_event_id": {"$ref": "#/$defs/nonEmptyId"}, "primary_framework": {"enum": ["natural", "social", "undetermined"]}, "transformation": {"enum": ["none", "keying", "fabrication", "rekeying", "misframing_candidate", "frame_break", "frame_dispute"]}, "frame_state": {"enum": ["stable", "ambiguous", "contested", "broken", "restored"]}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}},
    "identityInformation": {"type": "object", "additionalProperties": false, "required": ["identity_event_id", "participant_id", "management_type", "evidence_anchor_ids"], "properties": {"identity_event_id": {"$ref": "#/$defs/nonEmptyId"}, "participant_id": {"$ref": "#/$defs/nonEmptyId"}, "management_type": {"enum": ["identity_claim", "attribution", "discrediting", "passing_candidate", "covering_candidate", "disclosure", "concealment", "stigma_management_candidate", "other"]}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "sensitivity": {"enum": ["ordinary", "sensitive", "highly_sensitive"]}}},
    "interpretiveClaim": {"type": "object", "additionalProperties": false, "required": ["claim_text", "epistemic_level", "evidence_anchor_ids", "inferential_distance", "uncertainty_note"], "properties": {"claim_text": {"type": "string", "minLength": 1}, "epistemic_level": {"enum": ["candidate_interpretation", "confirmed_interpretation"]}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "inferential_distance": {"enum": ["proximal", "moderate", "extended"]}, "uncertainty_note": {"type": "string", "minLength": 1}}},
    "alternative": {"type": "object", "additionalProperties": false, "required": ["alternative_id", "claim", "status"], "properties": {"alternative_id": {"$ref": "#/$defs/nonEmptyId"}, "claim": {"type": "string", "minLength": 1}, "status": {"enum": ["retained", "preferred", "rejected", "unresolved"]}, "rationale": {"type": "string"}}},
    "projectionBindings": {"type": "object", "additionalProperties": false, "properties": {"meaning_network_relation_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "narrative_agent_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "scene_card_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "statskit_variable_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "governed_claim_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}}
  }
}
