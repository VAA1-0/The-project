{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datascene.example/schemas/morenoan_relational_configuration.schema.json",
  "title": "Relational Configuration, Role Enactment and Group Dynamics",
  "description": "A candidate interpretive lens for analysing sociometric relations, enacted and latent roles, spontaneity, psychodramatic or sociodramatic action, and emergent group configuration. It supports research analysis and does not perform clinical diagnosis.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "reading_id", "framework", "governance", "source_anchors", "persons_or_collectives", "role_relations", "interpretive_summary"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "reading_id": {"$ref": "#/$defs/nonEmptyId"},
    "framework": {
      "type": "object", "additionalProperties": false,
      "required": ["framework_id", "display_name", "principal_attribution", "scope", "reading_type"],
      "properties": {
        "framework_id": {"const": "morenoan_relational_configuration"},
        "display_name": {"const": "Relational Configuration, Role Enactment and Group Dynamics"},
        "principal_attribution": {"const": "Jacob L. Moreno; psychodrama, sociodrama, sociometry, role theory and group psychotherapy"},
        "scope": {"enum": ["sociometric", "psychodramatic", "sociodramatic", "group_relational", "integrated_morenoan"]},
        "reading_type": {"const": "interpretive_lens"},
        "concept_provenance": {"type": "array", "items": {"$ref": "#/$defs/conceptProvenance"}, "uniqueItems": true}
      }
    },
    "governance": {"$ref": "#/$defs/governance"},
    "ethics": {"$ref": "#/$defs/ethics"},
    "source_anchors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceAnchor"}},
    "persons_or_collectives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/person"}},
    "role_relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/roleRelation"}},
    "sociometric_relations": {"type": "array", "items": {"$ref": "#/$defs/sociometricRelation"}},
    "social_atoms": {"type": "array", "items": {"$ref": "#/$defs/socialAtom"}},
    "enacted_scenes": {"type": "array", "items": {"$ref": "#/$defs/enactedScene"}},
    "group_configuration": {"$ref": "#/$defs/groupConfiguration"},
    "interpretive_summary": {"$ref": "#/$defs/interpretiveClaim"},
    "alternatives": {"type": "array", "items": {"$ref": "#/$defs/alternative"}},
    "projection_bindings": {"$ref": "#/$defs/projectionBindings"}
  },
  "$defs": {
    "nonEmptyId": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "conceptProvenance": {"type": "object", "additionalProperties": false, "required": ["concept", "attribution", "relation_to_framework", "source_reference"], "properties": {"concept": {"type": "string", "minLength": 1}, "attribution": {"type": "string", "minLength": 1}, "relation_to_framework": {"enum": ["principal_concept", "co-developed_concept", "documented_influence", "antecedent", "parallel_development", "later_extension"]}, "source_reference": {"type": "string", "minLength": 1}, "note": {"type": "string"}}},
    "governance": {"type": "object", "additionalProperties": false, "required": ["record_status", "authority", "ledger_event_id", "created_at", "created_by", "dependency_ids", "input_snapshot_hash"], "properties": {"record_status": {"enum": ["candidate", "provisionally_accepted", "confirmed", "corrected", "rejected", "conflicted", "superseded", "invalidated", "stale", "unresolved"]}, "authority": {"enum": ["automated_candidate", "imported_candidate", "analyst_proposal", "analyst_confirmed", "analyst_corrected"]}, "ledger_event_id": {"$ref": "#/$defs/nonEmptyId"}, "supersedes_event_id": {"$ref": "#/$defs/nonEmptyId"}, "created_at": {"type": "string", "format": "date-time"}, "created_by": {"type": "string", "minLength": 1}, "provider": {"type": "string"}, "model_or_rule_version": {"type": "string"}, "parameters": {"type": "object"}, "dependency_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "input_snapshot_hash": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"}, "invalidation_reason": {"type": "string"}}},
    "ethics": {"type": "object", "additionalProperties": false, "required": ["use_context", "clinical_inference_prohibited", "sensitive_relation_controls"], "properties": {"use_context": {"enum": ["research_observation", "archival_analysis", "media_analysis", "facilitated_psychodrama", "facilitated_sociodrama", "other"]}, "clinical_inference_prohibited": {"const": true}, "participant_consent_reference": {"type": "string"}, "sensitive_relation_controls": {"type": "array", "minItems": 1, "items": {"enum": ["restricted_access", "pseudonymized", "aggregate_only", "participant_review", "not_applicable"]}, "uniqueItems": true}}},
    "sourceAnchor": {"type": "object", "additionalProperties": false, "required": ["source_id", "anchor_type", "clock_unit", "time_start", "time_end", "clock_authority", "precision_seconds"], "properties": {"source_id": {"$ref": "#/$defs/nonEmptyId"}, "anchor_type": {"enum": ["time_interval", "transcript_span", "frame", "roi", "document_span", "image_region", "web_region", "metadata_record"]}, "clock_unit": {"const": "source_relative_seconds"}, "time_start": {"type": "number", "minimum": 0}, "time_end": {"type": "number", "minimum": 0}, "clock_authority": {"type": "string", "minLength": 1}, "precision_seconds": {"type": "number", "minimum": 0}, "spatial_region": {"$ref": "#/$defs/spatialRegion"}, "text_quote": {"type": "string", "maxLength": 500}, "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}},
    "spatialRegion": {"type": "object", "additionalProperties": false, "required": ["coordinate_system", "x", "y", "width", "height"], "properties": {"coordinate_system": {"enum": ["normalized_0_1", "pixels"]}, "x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "person": {"type": "object", "additionalProperties": false, "required": ["participant_id", "participant_type", "designation", "evidence_anchor_ids"], "properties": {"participant_id": {"$ref": "#/$defs/nonEmptyId"}, "narrative_agent_id": {"$ref": "#/$defs/nonEmptyId"}, "participant_type": {"enum": ["person", "collective", "represented_person", "represented_collective"]}, "designation": {"type": "string", "minLength": 1}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}},
    "roleRelation": {"type": "object", "additionalProperties": false, "required": ["role_relation_id", "participant_id", "role_name", "role_state", "role_process", "counterrole_ids", "evidence_anchor_ids", "epistemic_status"], "properties": {"role_relation_id": {"$ref": "#/$defs/nonEmptyId"}, "participant_id": {"$ref": "#/$defs/nonEmptyId"}, "role_name": {"type": "string", "minLength": 1}, "role_domain": {"enum": ["psychosomatic", "psychodramatic", "social", "cultural", "organizational", "narrative", "other"]}, "role_state": {"enum": ["enacted", "ascribed", "claimed", "latent", "conflicted", "emergent", "rejected", "unknown"]}, "role_process": {"enum": ["role_taking", "role_playing", "role_creating", "role_reversal", "doubling", "mirroring", "none_observed", "undetermined"]}, "counterrole_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "epistemic_status": {"enum": ["observed_relation", "derived_relation", "candidate_interpretation", "confirmed_interpretation"]}, "rationale": {"type": "string", "minLength": 1}}},
    "sociometricRelation": {"type": "object", "additionalProperties": false, "required": ["relation_id", "from_participant_id", "to_participant_id", "criterion", "choice", "directionality", "evidence_anchor_ids", "disclosure_level"], "properties": {"relation_id": {"$ref": "#/$defs/nonEmptyId"}, "from_participant_id": {"$ref": "#/$defs/nonEmptyId"}, "to_participant_id": {"$ref": "#/$defs/nonEmptyId"}, "criterion": {"type": "string", "minLength": 1}, "choice": {"enum": ["positive", "negative", "neutral", "ambivalent", "unexpressed", "unknown"]}, "strength": {"type": "number", "minimum": 0, "maximum": 1}, "directionality": {"enum": ["directed", "reciprocal", "undetermined"]}, "tele_status": {"enum": ["positive_candidate", "negative_candidate", "mixed_candidate", "not_assessed"]}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "disclosure_level": {"enum": ["restricted", "pseudonymized", "aggregate", "publishable"]}}},
    "socialAtom": {"type": "object", "additionalProperties": false, "required": ["social_atom_id", "focal_participant_id", "relation_ids", "boundary_basis"], "properties": {"social_atom_id": {"$ref": "#/$defs/nonEmptyId"}, "focal_participant_id": {"$ref": "#/$defs/nonEmptyId"}, "relation_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "boundary_basis": {"type": "string", "minLength": 1}}},
    "enactedScene": {"type": "object", "additionalProperties": false, "required": ["scene_id", "scene_mode", "phase", "participant_ids", "role_relation_ids", "evidence_anchor_ids"], "properties": {"scene_id": {"$ref": "#/$defs/nonEmptyId"}, "scene_mode": {"enum": ["observed_everyday_action", "psychodramatic_enactment", "sociodramatic_enactment", "reported_or_represented_scene"]}, "phase": {"enum": ["warm_up", "action", "sharing", "not_applicable", "undetermined"]}, "participant_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "role_relation_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "dramatic_function": {"enum": ["protagonist", "director", "auxiliary_ego", "audience", "stage_or_setting", "mixed", "not_applicable"]}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}},
    "groupConfiguration": {"type": "object", "additionalProperties": false, "required": ["configuration_state", "assessment", "evidence_anchor_ids"], "properties": {"configuration_state": {"enum": ["not_assessed", "cohesive", "fragmented", "centralized", "polarized", "isolated", "reciprocal", "transitional", "mixed"]}, "assessment": {"type": "string", "minLength": 1}, "spontaneity_creativity": {"enum": ["not_assessed", "constricted", "routine", "adaptive", "emergent", "transformative"]}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}},
    "interpretiveClaim": {"type": "object", "additionalProperties": false, "required": ["claim_text", "epistemic_level", "evidence_anchor_ids", "inferential_distance", "uncertainty_note"], "properties": {"claim_text": {"type": "string", "minLength": 1}, "epistemic_level": {"enum": ["candidate_interpretation", "confirmed_interpretation"]}, "evidence_anchor_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "inferential_distance": {"enum": ["proximal", "moderate", "extended"]}, "uncertainty_note": {"type": "string", "minLength": 1}}},
    "alternative": {"type": "object", "additionalProperties": false, "required": ["alternative_id", "claim", "status"], "properties": {"alternative_id": {"$ref": "#/$defs/nonEmptyId"}, "claim": {"type": "string", "minLength": 1}, "status": {"enum": ["retained", "preferred", "rejected", "unresolved"]}, "rationale": {"type": "string"}}},
    "projectionBindings": {"type": "object", "additionalProperties": false, "properties": {"meaning_network_relation_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "narrative_agent_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "scene_card_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "statskit_variable_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}, "governed_claim_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyId"}, "uniqueItems": true}}}
  }
}
