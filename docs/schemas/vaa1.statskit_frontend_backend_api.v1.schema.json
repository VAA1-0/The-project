{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datascene.eu/schemas/vaa1.statskit_frontend_backend_api.v1.schema.json",
  "title": "Datascene/VAA1 StatsKit frontend-to-backend API contract",
  "description": "Discriminated request and response envelopes for planning, validating, running, interpreting, reviewing, reopening, and exporting governed StatsKit analyses.",
  "oneOf": [
    {"$ref": "#/$defs/request_envelope"},
    {"$ref": "#/$defs/response_envelope"},
    {"$ref": "#/$defs/event_envelope"}
  ],
  "$defs": {
    "core": {"$ref": "Datascene_VAA1_stats_interpretation_core_v1.schema.json"},
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "context": {
      "type": "object",
      "required": ["request_id", "analysis_id", "client_schema_version", "requested_at"],
      "properties": {
        "request_id": {"$ref": "#/$defs/identifier"},
        "analysis_id": {"$ref": "#/$defs/identifier"},
        "project_id": {"$ref": "#/$defs/identifier"},
        "active_source_media_id": {"$ref": "#/$defs/identifier"},
        "client_schema_version": {"const": "1.0.0"},
        "requested_at": {"$ref": "#/$defs/timestamp"},
        "actor": {
          "type": "object",
          "required": ["actor_id", "role"],
          "properties": {
            "actor_id": {"$ref": "#/$defs/identifier"},
            "role": {"enum": ["analyst", "reviewer", "administrator", "service"]}
          },
          "additionalProperties": false
        },
        "idempotency_key": {"$ref": "#/$defs/identifier"},
        "expected_analysis_plan_version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "command": {
      "enum": [
        "validate_analysis_plan",
        "save_analysis_plan",
        "run_analysis_plan",
        "preview_interpretations",
        "realize_sentences",
        "review_proposition",
        "review_sentence",
        "reopen_run",
        "export_governed_bundle"
      ]
    },
    "request_envelope": {
      "type": "object",
      "required": ["schema_name", "schema_version", "message_type", "command", "context", "payload"],
      "properties": {
        "schema_name": {"const": "vaa1.statskit_api"},
        "schema_version": {"const": "1.0.0"},
        "message_type": {"const": "request"},
        "command": {"$ref": "#/$defs/command"},
        "context": {"$ref": "#/$defs/context"},
        "payload": {"$ref": "#/$defs/request_payload"}
      },
      "allOf": [
        {"if": {"properties": {"command": {"enum": ["validate_analysis_plan", "save_analysis_plan"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/plan_payload"}}}},
        {"if": {"properties": {"command": {"const": "run_analysis_plan"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/run_payload"}}}},
        {"if": {"properties": {"command": {"enum": ["preview_interpretations", "realize_sentences"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/interpretation_payload"}}}},
        {"if": {"properties": {"command": {"enum": ["review_proposition", "review_sentence"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/review_payload"}}}},
        {"if": {"properties": {"command": {"const": "reopen_run"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/reopen_payload"}}}},
        {"if": {"properties": {"command": {"const": "export_governed_bundle"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/export_payload"}}}}
      ],
      "additionalProperties": false
    },
    "request_payload": {
      "oneOf": [
        {"$ref": "#/$defs/plan_payload"},
        {"$ref": "#/$defs/run_payload"},
        {"$ref": "#/$defs/interpretation_payload"},
        {"$ref": "#/$defs/review_payload"},
        {"$ref": "#/$defs/reopen_payload"},
        {"$ref": "#/$defs/export_payload"}
      ]
    },
    "plan_payload": {
      "type": "object",
      "required": ["payload_type", "analysis_plan"],
      "properties": {
        "payload_type": {"const": "analysis_plan"},
        "analysis_plan": {"$ref": "Datascene_VAA1_stats_interpretation_core_v1.schema.json#/$defs/analysis_plan"},
        "validate_only": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "run_payload": {
      "type": "object",
      "required": ["payload_type", "analysis_plan_id", "analysis_plan_version", "persist", "return_level"],
      "properties": {
        "payload_type": {"const": "run_analysis"},
        "analysis_plan_id": {"$ref": "#/$defs/identifier"},
        "analysis_plan_version": {"type": "integer", "minimum": 1},
        "persist": {"type": "boolean"},
        "return_level": {"enum": ["summary", "results", "results_and_diagnostics", "complete_bundle"]},
        "selected_method_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "force_recompute": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "interpretation_payload": {
      "type": "object",
      "required": ["payload_type", "result_refs", "operation", "language", "realization_mode"],
      "properties": {
        "payload_type": {"const": "interpretation"},
        "result_refs": {"type": "array", "minItems": 1, "items": {"$ref": "Datascene_VAA1_stats_interpretation_core_v1.schema.json#/$defs/record_ref"}},
        "operation": {"enum": ["build_propositions", "build_sentence_plans", "realize_sentences"]},
        "language": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
        "realization_mode": {"enum": ["deterministic_template", "constrained_language_model"]},
        "audience": {"enum": ["researcher", "archivist", "journalist", "policymaker", "curator", "editor", "public", "custom"]},
        "style_constraints": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "review_payload": {
      "type": "object",
      "required": ["payload_type", "target_ref", "decision"],
      "properties": {
        "payload_type": {"const": "review_decision"},
        "target_ref": {"$ref": "Datascene_VAA1_stats_interpretation_core_v1.schema.json#/$defs/record_ref"},
        "decision": {"enum": ["accept", "qualify", "reject", "supersede"]},
        "revised_text": {"type": "string"},
        "analyst_note": {"type": "string"},
        "added_counter_evidence_refs": {"type": "array", "items": {"$ref": "Datascene_VAA1_stats_interpretation_core_v1.schema.json#/$defs/record_ref"}},
        "added_alternative_explanations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "reopen_payload": {
      "type": "object",
      "required": ["payload_type", "run_id"],
      "properties": {
        "payload_type": {"const": "reopen_run"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "include_source_evidence": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "export_payload": {
      "type": "object",
      "required": ["payload_type", "run_id", "formats", "eligibility"],
      "properties": {
        "payload_type": {"const": "export"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["json", "csv", "txt", "data_book", "scientific_report"]}},
        "eligibility": {"enum": ["all_governed_records", "analyst_confirmed_only", "publication_eligible_only"]},
        "include_provenance_graph": {"type": "boolean", "default": true}
      },
      "additionalProperties": false
    },
    "response_envelope": {
      "type": "object",
      "required": ["schema_name", "schema_version", "message_type", "request_id", "command", "status", "responded_at"],
      "properties": {
        "schema_name": {"const": "vaa1.statskit_api"},
        "schema_version": {"const": "1.0.0"},
        "message_type": {"const": "response"},
        "request_id": {"$ref": "#/$defs/identifier"},
        "command": {"$ref": "#/$defs/command"},
        "status": {"enum": ["accepted", "completed", "validation_failed", "conflict", "failed"]},
        "responded_at": {"$ref": "#/$defs/timestamp"},
        "run": {"$ref": "#/$defs/run_status"},
        "data": {"$ref": "#/$defs/response_data"},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/api_error"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["validation_failed", "conflict", "failed"]}}}, "then": {"required": ["errors"]}},
        {"if": {"properties": {"status": {"const": "completed"}}}, "then": {"required": ["data"]}}
      ],
      "additionalProperties": false
    },
    "run_status": {
      "type": "object",
      "required": ["run_id", "state", "progress"],
      "properties": {
        "run_id": {"$ref": "#/$defs/identifier"},
        "state": {"enum": ["queued", "validating", "running", "interpreting", "persisting", "completed", "failed", "cancelled"]},
        "progress": {"type": "number", "minimum": 0, "maximum": 1},
        "current_stage": {"type": "string"},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "completed_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "response_data": {
      "type": "object",
      "properties": {
        "analysis_plan": {"$ref": "Datascene_VAA1_stats_interpretation_core_v1.schema.json#/$defs/analysis_plan"},
        "validation": {"$ref": "#/$defs/validation_report"},
        "results": {"type": "array", "items": {"$ref": "Datascene_VAA1_stats_interpretation_core_v1.schema.json#/$defs/statistical_result"}},
        "propositions": {"type": "array", "items": {"$ref": "Datascene_VAA1_stats_interpretation_core_v1.schema.json#/$defs/interpretation_proposition"}},
        "sentence_plans": {"type": "array", "items": {"$ref": "Datascene_VAA1_stats_interpretation_core_v1.schema.json#/$defs/sentence_plan"}},
        "report_sentences": {"type": "array", "items": {"$ref": "Datascene_VAA1_stats_interpretation_core_v1.schema.json#/$defs/report_sentence"}},
        "export_artifacts": {"type": "array", "items": {"$ref": "#/$defs/export_artifact"}},
        "persistence": {
          "type": "object",
          "required": ["persisted", "canonical_write", "record_refs"],
          "properties": {
            "persisted": {"type": "boolean"},
            "canonical_write": {"type": "boolean"},
            "record_refs": {"type": "array", "items": {"$ref": "Datascene_VAA1_stats_interpretation_core_v1.schema.json#/$defs/record_ref"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "validation_report": {
      "type": "object",
      "required": ["valid", "method_eligibility", "blocking_issues", "warnings"],
      "properties": {
        "valid": {"type": "boolean"},
        "method_eligibility": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["method_id", "eligible", "reasons", "required_actions"],
            "properties": {
              "method_id": {"$ref": "#/$defs/identifier"},
              "eligible": {"type": "boolean"},
              "reasons": {"type": "array", "items": {"type": "string"}},
              "required_actions": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "blocking_issues": {"type": "array", "items": {"$ref": "#/$defs/api_error"}},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/api_error"}}
      },
      "additionalProperties": false
    },
    "api_error": {
      "type": "object",
      "required": ["code", "message", "severity", "recoverable"],
      "properties": {
        "code": {"$ref": "#/$defs/identifier"},
        "message": {"type": "string", "minLength": 1},
        "severity": {"enum": ["information", "warning", "error", "blocking"]},
        "recoverable": {"type": "boolean"},
        "json_pointer": {"type": "string"},
        "required_action": {"type": "string"},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    },
    "export_artifact": {
      "type": "object",
      "required": ["artifact_id", "format", "filename", "checksum_algorithm", "checksum", "record_count"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "format": {"enum": ["json", "csv", "txt", "data_book", "scientific_report"]},
        "filename": {"type": "string", "minLength": 1},
        "checksum_algorithm": {"const": "sha256"},
        "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "record_count": {"type": "integer", "minimum": 0},
        "download_ref": {"type": "string"}
      },
      "additionalProperties": false
    },
    "event_envelope": {
      "type": "object",
      "required": ["schema_name", "schema_version", "message_type", "event_id", "run_id", "event_type", "emitted_at", "payload"],
      "properties": {
        "schema_name": {"const": "vaa1.statskit_api"},
        "schema_version": {"const": "1.0.0"},
        "message_type": {"const": "event"},
        "event_id": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "event_type": {"enum": ["run_queued", "validation_completed", "method_started", "method_completed", "interpretation_ready", "persistence_completed", "run_completed", "run_failed"]},
        "emitted_at": {"$ref": "#/$defs/timestamp"},
        "sequence": {"type": "integer", "minimum": 0},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
