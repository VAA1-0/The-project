{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datascene.vaa1/schemas/vaa1_mature_data_proliferation_governance.v1.json",
  "title": "VAA1 Mature Data Proliferation Governance Schema",
  "schema_name": "vaa1.mature_data_proliferation_governance.v1",
  "version": "1.0.0",
  "status": "operational_architecture_schema",
  "description": "Operational schema for governing VAA1 mature-data proliferation. The Master Schema is the single authority for mature semantic data. Panels are projections, not independent semantic authorities. Manual analyst corrections override automated detections. The propagation bus distributes mature Master Schema objects program-wide. The quality agent audits propagation and usability failures. SOM/open topology may be used diagnostically but must not become authority.",
  "operative_principle": {
    "core_promise": "VAA1 delivers multimodal analysis by maturing, governing, and proliferating linked evidence across all analytical surfaces.",
    "master_schema_invariant": "All active semantic claims visible in panels must be projections from governed Master Schema objects.",
    "panel_projection_rule": "Frontend panels may display, filter, edit, and navigate mature data, but must not become independent sources of semantic truth.",
    "manual_authority_rule": "Manual correction, confirmation, annotation, merge, split, rejection, or replacement has the highest operational authority.",
    "traceability_rule": "Every mature claim must preserve source anchors, evidence references, maturity state, authority level, and traceback.",
    "non_mutation_rule": "Proliferated candidates must not mutate source evidence; they generate governed projections and reviewable candidates.",
    "quality_rule": "Quality agents may audit, flag, and suggest corrections but must not silently overwrite governed mature data."
  },
  "authority_order": [
    {
      "rank": 1,
      "authority_level": "manual_correction",
      "description": "Analyst-corrected data. Highest authority. Overrides all automated and candidate-level evidence."
    },
    {
      "rank": 2,
      "authority_level": "manual_confirmation",
      "description": "Analyst-confirmed data. Stable mature truth unless superseded by later manual correction."
    },
    {
      "rank": 3,
      "authority_level": "manual_annotation",
      "description": "Analyst-created annotation. Authoritative unless later corrected, split, merged, rejected, or replaced."
    },
    {
      "rank": 4,
      "authority_level": "governed_metadata",
      "description": "User-provided or source-provided metadata routed through Master Schema governance."
    },
    {
      "rank": 5,
      "authority_level": "mature_triangulated_evidence",
      "description": "Cross-modal evidence with adequate maturity score and traceback."
    },
    {
      "rank": 6,
      "authority_level": "supported_candidate",
      "description": "Candidate supported by one or more evidence sources but still below mature authority."
    },
    {
      "rank": 7,
      "authority_level": "single_modality_candidate",
      "description": "Candidate derived from one modality only."
    },
    {
      "rank": 8,
      "authority_level": "raw_detection",
      "description": "Detector substrate. Preserved as provenance but never allowed to override mature data."
    }
  ],
  "maturity_states": [
    "raw_detection_seed",
    "local_candidate",
    "media_candidate",
    "media_array_candidate",
    "cross_modal_candidate",
    "probable",
    "strongly_supported",
    "analyst_named",
    "analyst_confirmed",
    "manual_correction",
    "merged_object",
    "split_object",
    "rejected_object",
    "archived_object",
    "blocked_from_proliferation"
  ],
  "master_schema_object": {
    "type": "object",
    "required": [
      "master_object_id",
      "object_family",
      "current_label",
      "maturity_state",
      "authority_level",
      "evidence_refs",
      "traceback_ref",
      "source_anchors",
      "projection_targets",
      "governance_status"
    ],
    "properties": {
      "master_object_id": {
        "type": "string",
        "examples": [
          "mso_000001"
        ]
      },
      "object_family": {
        "type": "string",
        "enum": [
          "NarrativeAgent",
          "PersonTrack",
          "Object",
          "AudioSample",
          "VisualSample",
          "TranscriptSegment",
          "Scene",
          "Episode",
          "Situation",
          "Interaction",
          "Action",
          "Movement",
          "Expression",
          "Role",
          "Relationship",
          "SFLFeature",
          "DependencyFeature",
          "SecondOrderLabel",
          "ReportClaim",
          "ForensicObservation",
          "MetadataSubject",
          "TracebackNode"
        ]
      },
      "legacy_aliases": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Compatibility layer for legacy identity/identification terms during migration."
      },
      "current_label": {
        "type": "string"
      },
      "previous_labels": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "maturity_state": {
        "type": "string"
      },
      "authority_level": {
        "type": "string"
      },
      "confidence": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "maximum": 1
      },
      "maturity_score": {
        "type": "object",
        "properties": {
          "overall_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "components": {
            "type": "object",
            "properties": {
              "manual_authority": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "source_traceability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "cross_modal_support": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "temporal_spatial_fit": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "semantic_fit": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "sample_cloud_support": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "metadata_support": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "open_weights": {
            "type": "object",
            "properties": {
              "manual_authority": {
                "type": "number"
              },
              "source_traceability": {
                "type": "number"
              },
              "cross_modal_support": {
                "type": "number"
              },
              "temporal_spatial_fit": {
                "type": "number"
              },
              "semantic_fit": {
                "type": "number"
              },
              "sample_cloud_support": {
                "type": "number"
              },
              "metadata_support": {
                "type": "number"
              }
            }
          }
        }
      },
      "source_modalities": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "video",
            "audio",
            "transcript",
            "metadata",
            "ocr",
            "object_detection",
            "face_embedding",
            "speaker_embedding",
            "prosody",
            "sfl",
            "dependency_parsing",
            "scene_card",
            "manual_annotation",
            "report_writer",
            "external_reference"
          ]
        }
      },
      "source_anchors": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "anchor_id",
            "anchor_type"
          ],
          "properties": {
            "anchor_id": {
              "type": "string"
            },
            "anchor_type": {
              "type": "string",
              "enum": [
                "media_time_interval",
                "frame_ref",
                "bbox",
                "roi",
                "waveform_region",
                "transcript_token_range",
                "transcript_segment",
                "scene_interval",
                "metadata_field",
                "dom_selector",
                "source_url",
                "report_section"
              ]
            },
            "source_media_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "time_interval": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "start_ms": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "end_ms": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "start_seconds": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "end_seconds": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "bbox": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                },
                "coordinate_system": {
                  "type": "string",
                  "default": "source_frame_pixels"
                }
              }
            },
            "panel_source": {
              "type": [
                "string",
                "null"
              ]
            },
            "stable_selector": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "evidence_refs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "evidence_id",
            "evidence_kind"
          ],
          "properties": {
            "evidence_id": {
              "type": "string"
            },
            "evidence_kind": {
              "type": "string",
              "enum": [
                "manual_correction",
                "manual_confirmation",
                "manual_annotation",
                "metadata_reference",
                "raw_detection",
                "proliferated_candidate",
                "cross_modal_support",
                "audio_sample_cloud",
                "visual_sample_cloud",
                "face_embedding_match",
                "speaker_embedding_match",
                "sfl_feature",
                "dependency_feature",
                "scene_card",
                "second_order_label",
                "traceback_node",
                "report_claim"
              ]
            },
            "authority_level": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "support_score": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "provenance_note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "traceback_ref": {
        "type": "string"
      },
      "relations": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "relation_type",
            "target_master_object_id"
          ],
          "properties": {
            "relation_type": {
              "type": "string",
              "enum": [
                "same_as",
                "possible_same_as",
                "derived_from",
                "supports",
                "contradicts",
                "member_of",
                "participant_in",
                "speaker_of",
                "owner_of_expression",
                "actor_of_action",
                "subject_of_role",
                "located_in_scene",
                "appears_in_episode",
                "used_by_report_claim",
                "needs_review_against"
              ]
            },
            "target_master_object_id": {
              "type": "string"
            },
            "relation_confidence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "review_state": {
              "type": "string",
              "enum": [
                "unreviewed",
                "candidate",
                "confirmed",
                "rejected",
                "blocked"
              ],
              "default": "unreviewed"
            }
          }
        }
      },
      "projection_targets": {
        "type": "array",
        "description": "Panels/features that must receive this mature object as projected state.",
        "items": {
          "type": "string",
          "enum": [
            "backend_agent_registry",
            "frontend_global_state",
            "master_schema_panel",
            "video_panel",
            "bbox_roi_panel",
            "objects_panel",
            "audio_panel",
            "sample_cloud_panel",
            "transcript_panel",
            "diarization_panel",
            "pos_analysis_panel",
            "dependency_sfl_panel",
            "scene_browser",
            "scene_card_panel",
            "mise_en_scene_panel",
            "meaning_plot_panel",
            "narrative_agent_panel",
            "traceback_drawer",
            "evidence_graph",
            "governance_matrix",
            "search_index",
            "report_writer",
            "export_payloads"
          ]
        }
      },
      "governance_status": {
        "type": "object",
        "required": [
          "active",
          "proliferation_allowed",
          "review_required"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "proliferation_allowed": {
            "type": "boolean"
          },
          "review_required": {
            "type": "boolean"
          },
          "review_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "conflict_state": {
            "type": "string",
            "enum": [
              "none",
              "weak_conflict",
              "strong_conflict",
              "manual_conflict",
              "blocked"
            ],
            "default": "none"
          },
          "unknown_override_blocked": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "propagation_bus": {
    "type": "object",
    "description": "Single program-wide channel for distributing mature Master Schema state.",
    "required": [
      "bus_id",
      "events",
      "audit_log"
    ],
    "properties": {
      "bus_id": {
        "type": "string",
        "default": "vaa1_mature_data_proliferation_bus"
      },
      "events": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "event_id",
            "event_type",
            "master_object_id",
            "source_of_change",
            "authority_level",
            "must_propagate_to",
            "partial_propagation_allowed"
          ],
          "properties": {
            "event_id": {
              "type": "string"
            },
            "event_type": {
              "type": "string",
              "enum": [
                "master_object_created",
                "maturity_state_changed",
                "label_changed",
                "manual_correction_applied",
                "manual_confirmation_applied",
                "object_merged",
                "object_split",
                "object_rejected",
                "object_archived",
                "evidence_added",
                "traceback_updated",
                "sample_cloud_match_added",
                "scene_participation_updated",
                "second_order_label_affirmed",
                "projection_refresh_required",
                "unknown_override_blocked"
              ]
            },
            "master_object_id": {
              "type": "string"
            },
            "previous_state": {
              "type": [
                "object",
                "null"
              ]
            },
            "new_state": {
              "type": [
                "object",
                "null"
              ]
            },
            "changed_fields": {
              "type": "object"
            },
            "source_of_change": {
              "type": "string",
              "enum": [
                "manual_analyst_action",
                "metadata_ingest",
                "maturity_engine",
                "sample_cloud_matcher",
                "second_order_proliferation",
                "scene_card_governance",
                "sfl_dependency_engine",
                "traceback_engine",
                "quality_agent_suggestion"
              ]
            },
            "authority_level": {
              "type": "string"
            },
            "must_propagate_to": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "partial_propagation_allowed": {
              "type": "boolean",
              "default": false
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "audit_log": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "audit_id",
            "event_id",
            "target",
            "status"
          ],
          "properties": {
            "audit_id": {
              "type": "string"
            },
            "event_id": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "success",
                "failed",
                "blocked",
                "stale"
              ]
            },
            "failure_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "last_checked_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  },
  "governance_matrix": {
    "type": "object",
    "description": "Linear comparison view of all governed Master Schema objects.",
    "required": [
      "columns",
      "rows"
    ],
    "properties": {
      "columns": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "master_object_id",
          "object_family",
          "current_label",
          "maturity_state",
          "authority_level",
          "overall_maturity_score",
          "source_modalities",
          "source_anchors",
          "traceback_ref",
          "used_by_panels",
          "propagation_status",
          "conflict_state",
          "last_analyst_action",
          "review_required"
        ]
      },
      "rows": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "master_object_id": {
              "type": "string"
            },
            "object_family": {
              "type": "string"
            },
            "current_label": {
              "type": "string"
            },
            "maturity_state": {
              "type": "string"
            },
            "authority_level": {
              "type": "string"
            },
            "overall_maturity_score": {
              "type": [
                "number",
                "null"
              ]
            },
            "source_modalities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source_anchors": {
              "type": "array"
            },
            "traceback_ref": {
              "type": "string"
            },
            "used_by_panels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "propagation_status": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "failed",
                "pending",
                "stale"
              ]
            },
            "conflict_state": {
              "type": "string"
            },
            "last_analyst_action": {
              "type": [
                "string",
                "null"
              ]
            },
            "review_required": {
              "type": "boolean"
            }
          }
        }
      }
    }
  },
  "quality_agent": {
    "type": "object",
    "description": "Audit-only agent for checking mature-data proliferation failures.",
    "required": [
      "agent_name",
      "authority_policy",
      "checks"
    ],
    "properties": {
      "agent_name": {
        "type": "string",
        "default": "MasterSchemaQualityAgent"
      },
      "authority_policy": {
        "type": "object",
        "properties": {
          "may_overwrite_master_schema": {
            "type": "boolean",
            "const": false
          },
          "may_create_review_tickets": {
            "type": "boolean",
            "const": true
          },
          "may_suggest_patches": {
            "type": "boolean",
            "const": true
          },
          "may_block_unknown_overrides": {
            "type": "boolean",
            "const": true
          },
          "requires_analyst_confirmation_for_authority_change": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "missing_traceback",
            "visible_without_master_schema_object",
            "unknown_overrides_known_agent",
            "panel_state_diverges_from_master_schema",
            "manual_correction_not_propagated",
            "manual_merge_not_propagated",
            "manual_split_not_propagated",
            "sample_cloud_not_polled",
            "mature_label_missing_from_bbox",
            "mature_label_missing_from_transcript",
            "scene_card_not_back_propagating_to_bbox",
            "sfl_feature_not_projected_to_pos_matrix",
            "second_order_label_not_projected",
            "conflicting_agent_labels",
            "orphan_evidence",
            "stale_localstorage_proliferation",
            "missing_source_anchor",
            "missing_governance_matrix_row"
          ]
        },
        "default": [
          "missing_traceback",
          "visible_without_master_schema_object",
          "unknown_overrides_known_agent",
          "panel_state_diverges_from_master_schema",
          "manual_correction_not_propagated",
          "sample_cloud_not_polled",
          "mature_label_missing_from_bbox",
          "conflicting_agent_labels",
          "orphan_evidence"
        ]
      },
      "review_ticket": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "finding_type": {
            "type": "string"
          },
          "affected_master_object_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affected_panels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggested_action": {
            "type": "string"
          },
          "requires_analyst_review": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "som_open_topology_diagnostic": {
    "type": "object",
    "description": "Optional diagnostic topology layer. SOM may reveal evidence neighborhoods, duplication, fragmentation, outliers, and weak proliferation zones. It must not act as semantic authority.",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "authority_policy": {
        "type": "object",
        "properties": {
          "som_is_authority": {
            "type": "boolean",
            "const": false
          },
          "som_may_generate_candidates": {
            "type": "boolean",
            "const": true
          },
          "som_candidates_require_master_schema_governance": {
            "type": "boolean",
            "const": true
          },
          "som_nodes_require_traceback": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "input_feature_families": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "narrative_agent_vectors",
            "audio_sample_embeddings",
            "speaker_embeddings",
            "visual_sample_embeddings",
            "face_embeddings",
            "clothing_histograms",
            "object_detection_features",
            "transcript_sfl_features",
            "dependency_features",
            "scene_feature_vectors",
            "expression_features",
            "prosody_features",
            "second_order_label_vectors"
          ]
        }
      },
      "node": {
        "type": "object",
        "required": [
          "som_node_id",
          "linked_master_object_ids"
        ],
        "properties": {
          "som_node_id": {
            "type": "string"
          },
          "coordinates": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              }
            }
          },
          "linked_master_object_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "diagnostic_labels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "coherent_cluster",
