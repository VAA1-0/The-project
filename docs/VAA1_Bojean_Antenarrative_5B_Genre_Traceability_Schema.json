{
  "schema_name": "VAA1_Bojean_Antenarrative_5B_Genre_Traceability_Schema",
  "schema_version": "0.1.0",
  "created_for": "VAA1 / Datascene",
  "operative_principle": {
    "summary": "This schema operationalizes Bojean antenarrative analysis inside VAA1 as a traceable, navigable, genre-sensitive, multimodal interpretation layer. The system treats transcript and text-based linguistic evidence as the first mature analytical substrate, then cultivates audio, visual, spatial, metadata, and analyst-validated evidence around it. Boje's 5 B's are not implemented as isolated labels, but as situated antenarrative functions conditioned by genre, scene, speaker, institutional context, and available multimodal evidence.",
    "core_rules": [
      "All antenarrative claims must remain linked to source evidence.",
      "All detections must be timestamped where source media allows it.",
      "All visual evidence must be spatially linked through BBox/ROI or frame-level references where applicable.",
      "Transcript and linguistic detections are the initial maturity baseline.",
      "Genre conditions interpretation; it does not replace evidence.",
      "Manual analyst validation overrides automated detection, while raw detections remain preserved for traceback.",
      "Every 5B object must be navigable from and to transcript, POS matrix, scene browser, BBox/ROI panel, narrative agents, timeline, traceback drawer, and report outputs.",
      "Visual detections are cultivated gradually and initially treated as supportive or contextual evidence unless analyst-confirmed.",
      "5B objects may feed other VAA1 features, including POS analysis, SFL/dependency parsing, narrative agents, plot candidates, worldview analysis, quantitative analysis, and report writing."
    ]
  },
