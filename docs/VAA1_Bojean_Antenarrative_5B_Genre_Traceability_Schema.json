    "dramatic_genres": [
      "tragedy",
      "comedy",
      "satire",
      "epic",
      "thriller",
      "documentary",
      "romance",
      "horror",
      "adult_entertainment",
      "science_fiction",
      "animation",
      "musical"
    ],
    "dramatic_genre_conditioning_rules": {
      "tragedy": {
        "increase_weight": [
          "becoming",
          "beneath",
          "between"
        ],
        "interpretive_bias": "Track transformation toward collapse, loss, recognition, fate, or moral consequence."
      },
      "comedy": {
        "increase_weight": [
          "between",
          "before"
        ],
        "interpretive_bias": "Treat contradiction, mismatch, timing, and reversal as potentially humorous rather than simply incoherent."
      },
      "satire": {
        "increase_weight": [
          "beneath",
          "between"
        ],
        "interpretive_bias": "Prioritize exposure of hidden power, hypocrisy, institutional absurdity, and ideological contradiction."
      },
      "epic": {
        "increase_weight": [
          "bets",
          "becoming"
        ],
        "interpretive_bias": "Track collective destiny, quest formation, world-scale stakes, and heroic transformation."
      },
      "thriller": {
        "increase_weight": [
          "before",
          "between"
        ],
        "interpretive_bias": "Treat fragmentation, concealment, threat signals, and uncertainty as tension-building structures."
      },
      "documentary": {
        "increase_weight": [
          "beneath",
          "becoming",
          "between"
        ],
        "interpretive_bias": "Prioritize real-world institutional context, testimony, evidence, and contested truth claims."
      },
      "romance": {
        "increase_weight": [
          "becoming",
          "bets",
          "between"
        ],
        "interpretive_bias": "Track intimacy formation, attachment, vulnerability, jealousy, promise, rupture, repair, and relational transformation."
      },
      "horror": {
        "increase_weight": [
          "before",
          "beneath",
          "between"
        ],
        "interpretive_bias": "Track threat emergence, contamination, hidden monstrosity, survival projection, panic, and safety collapse."
      },
      "adult_entertainment": {
        "increase_weight": [
          "before",
          "bets",
          "becoming",
          "beneath",
          "between"
        ],
        "interpretive_bias": "Treat the genre as intimacy-performance systems involving bodily rhetoric, fantasy framing, consent negotiation, role performance, power dynamics, and symbolic interaction rather than simplistic explicit-content scoring."
      },
      "science_fiction": {
        "increase_weight": [
          "bets",
          "becoming",
          "beneath",
          "between"
        ],
        "interpretive_bias": "Track speculative futures, technological systems, posthuman change, governance critique, civilizational risk, utopia, dystopia, and hidden present-day ideology."
      },
      "animation": {
        "increase_weight": [
          "before",
          "becoming",
          "beneath",
          "between"
        ],
        "interpretive_bias": "Use non-naturalistic interpretation. Exaggerated gestures, impossible physics, color shifts, and stylized embodiment may encode symbolic or emotional functions rather than literal physical behavior."
      },
      "musical": {
        "increase_weight": [
          "bets",
          "becoming",
          "between"
        ],
        "interpretive_bias": "Treat music, lyrics, rhythm, choreography, chorus structures, and synchronized movement as primary communicative modalities."
      }
    }
  },
