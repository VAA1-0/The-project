    ],
    "conditioning_layers": [
      "genre_context",
      "institutional_context",
      "platform_context",
      "interaction_context",
      "dramatic_context",
      "cultural_context",
      "source_reliability_context"
    ],
    "interpretation_layers": [
      "bojean_5B_candidate_detection",
      "cross_modal_support",
      "antenarrative_relation_mapping",
      "maturity_assessment",
      "analyst_validation",
      "publication_ready_claim_generation"
    ],
    "output_layers": [
      "POS_matrix",
      "scene_browser",
      "narrative_agents",
      "BBox_ROI_panel",
      "traceback_drawer",
      "timeline",
      "meaning_plot_candidates",
      "worldview_analysis",
      "quantitative_analysis",
      "report_writer_agent"
    ]
  },
  "bojean_5B_taxonomy": {
    "before": {
      "definition": "Pre-narrative fragments, weak signals, unfinished meanings, ambiguity, emergent motifs, and unstable sensemaking before a stabilized narrative takes shape.",
      "dominant_question": "What is beginning to emerge before it becomes coherent?",
      "linguistic_targets": [
        "hedging",
        "unfinished syntax",
        "ellipsis",
        "ambiguous pronouns",
        "modal uncertainty",
        "low coherence",
        "emergent repeated keywords",
        "weakly connected noun phrases",
        "discourse markers",
        "self-correction",
        "interruption",
        "fragmented testimony",
        "vague temporal references",
        "incomplete causal claims"
      ],
      "pos_and_syntax_patterns": [
        "high pronoun density",
        "interjections",
        "modal auxiliaries",
        "sentence fragments",
        "discourse particles",
        "low main-verb completion",
        "weak dependency cohesion"
      ],
      "audio_targets": [
        "hesitation",
        "long pauses",
        "nervous laughter",
        "breath instability",
        "unfinished cadence"
      ],
      "visual_targets": [
        "uncertain gestures",
        "unstable crowd formation",
        "emerging symbols",
        "partial signage",
        "ambiguous spatial attention"
      ],
      "typical_outputs": [
        "weak_signal_cluster",
        "fragment_candidate",
        "emergent_motif",
        "unstable_interpretation"
      ]
    },
    "bets": {
      "definition": "Future-oriented claims, projections, promises, strategies, wagers, roadmaps, hopes, threats, and institutional commitments.",
      "dominant_question": "What future is being projected, promised, risked, or strategically wagered?",
      "linguistic_targets": [
        "future tense",
        "promissory language",
        "strategic verbs",
        "roadmap language",
        "vision statements",
        "investment language",
        "risk language",
        "conditional futures",
        "scenario language",
        "mission statements",
        "prediction",
        "expectation",
        "commitment",
        "obligation",
        "policy target language"
      ],
      "pos_and_syntax_patterns": [
        "future auxiliaries",
        "modal verbs such as will, shall, must, should, could",
        "conditional clauses",
        "commitment verbs",
        "purpose clauses",
        "teleological constructions"
      ],
      "audio_targets": [
        "confident declarative tone",
        "emphatic future projection",
        "pitch-like escalation"
      ],
      "visual_targets": [
        "future mockups",
        "roadmaps",
        "vision slides",
        "renderings",
        "symbolic future imagery",
        "technology demonstrations"
      ],
      "typical_outputs": [
        "strategic_bet",
        "future_projection",
        "institutional_commitment",
        "risk_claim",
        "promise_chain"
      ]
    },
    "becoming": {
      "definition": "Processes of transformation, identity change, role shift, institutional evolution, movement formation, relational development, and ontological transition.",
      "dominant_question": "What is changing, transforming, becoming, or reconfiguring?",
      "linguistic_targets": [
        "identity transformation language",
        "role change",
        "process verbs",
        "developmental sequencing",
        "before-after contrast",
        "self-description shift",
        "movement from old to new",
        "evolution language",
        "transition markers",
        "learning language",
        "emergence language",
        "conversion language",
        "professionalization",
        "radicalization",
        "normalization"
      ],
      "pos_and_syntax_patterns": [
        "dynamic verbs",
        "temporal adverbs",
        "comparatives",
        "change-of-state verbs",
        "first-person singular/plural shifts",
        "progressive aspect",
        "sequence markers"
      ],
      "audio_targets": [
        "emotional shift",
        "voice softening or intensification",
        "reflective cadence"
      ],
      "visual_targets": [
        "symbolic transition",
        "wardrobe change",
        "ritual behavior",
        "spatial repositioning",
        "identity markers",
        "movement from margin to centre"
      ],
      "typical_outputs": [
        "identity_shift",
        "transformation_sequence",
        "role_transition",
        "process_arc",
        "institutional_evolution"
      ]
    },
    "beneath": {
      "definition": "Latent structures, hidden assumptions, ideological formations, institutional power, material conditions, suppressed agency, and deep cultural logics shaping visible events.",
      "dominant_question": "What hidden structures, assumptions, powers, or material conditions are operating beneath the visible narrative?",
      "linguistic_targets": [
        "passive voice",
        "institutional abstraction",
        "nominalisation",
        "hidden agency",
        "bureaucratic compression",
        "ideological vocabulary",
        "taken-for-granted assumptions",
        "depersonalized responsibility",
        "technical inevitability claims",
        "naturalization",
        "legitimation language",
        "classification language",
        "governance vocabulary",
        "material substrate references"
      ],
      "pos_and_syntax_patterns": [
        "nominalisations",
        "agentless passive constructions",
        "abstract nouns",
        "institutional nouns",
        "high noun-to-verb ratio",
        "suppressed subject",
        "prepositional chains"
      ],
      "audio_targets": [
        "authority tone",
        "bureaucratic flatness",
        "controlled affect"
      ],
      "visual_targets": [
        "spatial hierarchy",
        "institutional symbols",
        "dominance framing",
        "exclusionary composition",
        "architecture of authority",
        "backstage infrastructures"
      ],
      "typical_outputs": [
        "hidden_structure_claim",
        "ideological_substrate",
        "institutional_power_pattern",
        "material_condition",
        "suppressed_agency"
      ]
    },
    "between": {
      "definition": "Dialogic tension, contradiction, disagreement, negotiation, conflict, irony, rupture, and contested meaning between actors, positions, scenes, institutions, or claims.",
      "dominant_question": "Where is meaning contested, contradicted, negotiated, or split?",
      "linguistic_targets": [
        "negation",
        "contrast markers",
        "counterclaims",
        "rebuttals",
        "concessive clauses",
        "reported disagreement",
        "polarized adjectives",
        "irony markers",
        "correction",
        "question-answer tension",
        "stance opposition",
        "argumentative sequencing",
        "disclaimer-plus-claim structures",
        "conflict verbs"
      ],
      "pos_and_syntax_patterns": [
        "adversative conjunctions",
        "negation particles",
        "concessive clauses",
        "contrastive discourse markers",
        "reported speech structures",
        "interrogatives",
        "antonym pairs"
      ],
      "audio_targets": [
        "interruption",
        "overlap",
        "prosodic tension",
        "raised intensity",
        "sarcasm-like contour"
      ],
      "visual_targets": [
        "opposing spatial groups",
        "conflicting signs",
        "divided frame composition",
        "confrontational posture",
        "symbolic clash",
        "gesture disagreement"
      ],
      "typical_outputs": [
        "contradiction_chain",
        "dialogic_tension",
        "conflict_cluster",
        "negotiation_sequence",
        "polarization_signal"
      ]
    }
  },
  "genre_context": {
    "operative_rule": "Genre is an interpretive conditioning layer. It calibrates how linguistic, visual, audio, and interactional signals are interpreted by the 5B system. Genre never replaces evidence and must be analyst-correctable.",
    "genre_object": {
      "genre_context_id": "uuid",
      "scope": "project|document|media_file|scene|segment|speaker_turn|bbox_roi|claim",
