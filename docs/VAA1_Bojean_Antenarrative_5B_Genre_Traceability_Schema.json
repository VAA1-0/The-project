  "visual_detection_cultivation_plan": {
    "operative_rule": "Visual 5B detection must be cultivated gradually. Early visual evidence supports, contextualizes, contradicts, or intensifies text-based 5B claims. It becomes primary only when sufficiently mature or analyst-confirmed.",
    "phases": {
      "phase_1_manual_symbolic_annotation": {
        "goal": "Let analysts manually tag visual evidence and link it to scenes, BBox/ROI objects, and 5B claims.",
        "annotation_targets": [
          "protest_sign",
          "institutional_logo",
          "stage_setting",
          "gesture",
          "crowd_formation",
          "object_of_authority",
          "symbolic_object",
          "ritual_action",
          "spatial_hierarchy",
          "future_mockup",
          "romantic_proximity",
          "horror_threat_signal",
          "musical_choreography",
          "science_fiction_interface",
          "animation_symbolic_distortion"
        ]
      },
      "phase_2_detector_support": {
        "goal": "Use computer vision and OCR as supportive evidence.",
        "detectors": [
          "object_detection",
          "OCR",
          "face_detection",
          "pose_estimation",
          "scene_segmentation",
          "shot_boundary_detection",
          "logo_detection",
          "visual_embedding_similarity",
          "color_palette_summary",
          "spatial_composition_analysis"
        ]
      },
      "phase_3_visual_rhetoric_patterns": {
        "goal": "Detect recurring symbolic arrangements and visual rhetoric.",
        "patterns": [
          "leader_elevated_above_crowd",
          "institutional_backdrop",
          "conflict_staging",
          "future_oriented_mockup",
          "ritual_transition",
          "isolation_in_frame",
          "dominance_spatiality",
          "intimacy_choreography",
          "collective_synchronization",
          "threat_emergence",
          "symbolic_exclusion",
          "technological_sublime"
        ]
      },
      "phase_4_cross_modal_claims": {
        "goal": "Connect text-based 5B claims to visual and audio evidence.",
        "allowed_relations": [
          "supports",
          "contradicts",
          "intensifies",
          "contextualizes",
          "weakens",
          "extends",
          "transforms"
        ]
      },
      "phase_5_analyst_validated_visual_5B": {
        "goal": "Allow visual evidence to become publication-ready when analyst-confirmed and traceable.",
        "requirements": [
          "timestamp_reference",
          "frame_reference",
          "BBox_or_ROI_reference_if_applicable",
          "visual_detection_or_manual_annotation_source",
          "genre_context",
          "traceback_chain",
          "analyst_confirmation"
        ]
      }
    }
  },
